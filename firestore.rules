// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - uid: string (required)
//   - displayName: string
//   - email: string (required)
//   - streakCount: number
//   - lastActiveDate: timestamp
//   - dailyGoalMet: boolean
//   - xp: number
//   - rank: string
//   - title: string
//   - dailyGoal: number
//   - avatar: string
//   - ownedAvatars: list
//   - preferredTTS: string
//   - notificationsEnabled: boolean
//   - achievements: list
//   - pinnedAchievements: list
//   - apiKeys: list
//   - quoteCache: list
//   - quoteStats: map
//   - dob: string
//   - careerGoal: string
//   - onboardingCompleted: boolean
//
// Collection: users/{userId}/vocabularies
// Document ID: {vocabId}
// Fields:
//   - uid: string (required)
//   - japanese: string (required, max 100)
//   - meaning: string (required, max 500)
//   - romaji: string (max 100)
//   - createdAt: timestamp (required)
//   - mastery: number (0-5)
//   - parentId: string
//   - type: string
//   - deleted: boolean
//
// Collection: users/{userId}/notes
// Document ID: {noteId}
// Fields:
//   - title: string (required)
//   - content: string (required)
//   - createdAt: timestamp (required)
//   - updatedAt: timestamp (required)
//   - color: string
//
// Collection: users/{userId}/discovered_words
// Document ID: {wordId}
// Fields:
//   - jp: string (required)
//   - ro: string
//   - en: string (required)
//   - createdAt: timestamp
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email_verified == true && request.auth.token.email == "riteshkumar477823@gmail.com"));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('preferredTTS' in data) || data.preferredTTS is string) &&
             (!('role' in data) || data.role is string) &&
             (!('customId' in data) || data.customId is string) &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    function isValidVocab(data) {
      return data.keys().hasAll(['japanese', 'meaning']) &&
             data.japanese is string &&
             data.meaning is string;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'content']) &&
             data.title is string &&
             data.content is string;
    }

    function isValidDiscoveredWord(data) {
      return data.keys().hasAll(['jp', 'en']) &&
             data.jp is string &&
             data.en is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /payment_requests/{requestId} {
      allow read, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /test/connection {
      allow read: if isAuthenticated();
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow create, update: if isAuthenticated(); // Allow users to contribute for now, or tighten to isAdmin()
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();

      match /vocabularies/{vocabId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidVocab(request.resource.data);
        allow update: if isOwner(userId) && isValidVocab(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidNote(request.resource.data);
        allow update: if isOwner(userId) && isValidNote(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /discovered_words/{wordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDiscoveredWord(request.resource.data);
        allow update: if isOwner(userId) && isValidDiscoveredWord(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
