{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and learning progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "streakCount": { "type": "integer" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "dailyGoalMet": { "type": "boolean" },
        "xp": { "type": "integer" },
        "rank": { "type": "string" },
        "title": { "type": "string" },
        "dailyGoal": { "type": "integer" },
        "avatar": { "type": "string" },
        "ownedAvatars": { "type": "array", "items": { "type": "string" } },
        "preferredTTS": { "type": "string", "enum": ["native", "gemini"] },
        "notificationsEnabled": { "type": "boolean" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "pinnedAchievements": { "type": "array", "items": { "type": "string" } },
        "apiKeys": { "type": "array", "items": { "type": "string" } },
        "quoteCache": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "translation": { "type": "string" }
            }
          } 
        },
        "quoteStats": {
          "type": "object",
          "properties": {
            "lastDate": { "type": "string" },
            "count": { "type": "integer" }
          }
        },
        "apiSettings": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["universal", "particular"] },
            "universalKeys": { "type": "array", "items": { "type": "string" } },
            "translationKeys": { "type": "array", "items": { "type": "string" } },
            "senseiKeys": { "type": "array", "items": { "type": "string" } },
            "dictionaryKeys": { "type": "array", "items": { "type": "string" } },
            "structuredKeys": {
              "type": "object",
              "properties": {
                "universal": { "type": "array", "items": { "$ref": "APIKey" } },
                "translation": { "type": "array", "items": { "$ref": "APIKey" } },
                "sensei": { "type": "array", "items": { "$ref": "APIKey" } },
                "dictionary": { "type": "array", "items": { "$ref": "APIKey" } }
              }
            }
          }
        },
        "aiCache": { "type": "object" },
        "dictionarySearchesToday": { "type": "integer" },
        "gameTimeToday": { "type": "integer" },
        "claimedRewards": { "type": "array", "items": { "type": "string" } },
        "customPhrases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jp": { "type": "string" },
              "ro": { "type": "string" },
              "en": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        },
        "role": { "type": "string", "enum": ["admin", "user", "client"] },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "dob": { "type": "string" },
        "careerGoal": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "APIKey": {
      "title": "APIKey",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "provider": { "type": "string", "enum": ["gemini", "openai", "anthropic", "openrouter", "xai"] },
        "baseUrl": { "type": "string" },
        "customProvider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "Vocabulary": {
      "title": "Vocabulary",
      "description": "Japanese words added by the user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "japanese": { "type": "string" },
        "meaning": { "type": "string" },
        "romaji": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mastery": { "type": "integer" },
        "parentId": { "type": "string" },
        "type": { "type": "string", "enum": ["main", "sub"] },
        "details": { "type": "string" }
      },
      "required": ["uid", "japanese", "meaning"]
    },
    "Note": {
      "title": "Note",
      "description": "User's personal notes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "color": { "type": "string" },
        "isPinned": { "type": "boolean" }
      },
      "required": ["title", "content", "createdAt", "updatedAt"]
    },
    "DiscoveredWord": {
      "title": "DiscoveredWord",
      "description": "Words discovered by the user in the dictionary",
      "type": "object",
      "properties": {
        "jp": { "type": "string" },
        "ro": { "type": "string" },
        "en": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jp", "ro", "en"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Subscription payment verification requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "planId", "transactionId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/vocabularies/{vocabId}": {
      "schema": "Vocabulary",
      "description": "User's personal vocabulary list"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User's personal notes"
    },
    "/users/{userId}/discovered_words/{wordId}": {
      "schema": "DiscoveredWord",
      "description": "Words discovered in the dictionary"
    },
    "/payment_requests/{requestId}": {
      "schema": "PaymentRequest",
      "description": "Global collection for admins to review payments"
    }
  }
}
